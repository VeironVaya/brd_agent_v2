{
  "info": {
    "_postman_id": "bca53c2c-76e9-4dff-b469-ce6252e51667",
    "name": "Hitakari LLM Marketplace",
    "description": "Ready-to-import Postman collection for the OpenAI-compatible endpoints exposed by the Hitakari LLM Gateway.\n\nAuthentication: Bearer {{apiKey}}\nBase URL: {{baseUrl}}\n\nStart with `List Available Models`, then replace the model variables with IDs available to your key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const apiKey = pm.environment.get(\"apiKey\") || pm.collectionVariables.get(\"apiKey\");",
          "if (!apiKey || apiKey === 'sk-your-hitakari-key') {",
          "    console.warn(\"Set the apiKey variable before sending authenticated requests.\");",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "OpenAI Proxy",
      "item": [
        {
          "name": "List Available Models",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/models",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "models"
              ]
            },
            "description": "Returns model IDs available to the current Hitakari API key. Run this request first, then update the model variables in the collection or environment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 2xx\", function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "",
                  "try {",
                  "    const payload = pm.response.json();",
                  "    const models = Array.isArray(payload.data) ? payload.data.map(item => item.id) : [];",
                  "    console.log(\"Available Hitakari models:\", models);",
                  "} catch (error) {",
                  "    console.warn(\"Response is not valid JSON:\", error.message);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Chat Completions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{chatModel}}\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a helpful assistant.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Jelaskan AI generatif dalam satu paragraf singkat.\"\n    }\n  ],\n  \"temperature\": 0.7,\n  \"max_tokens\": 300,\n  \"stream\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/chat/completions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "completions"
              ]
            },
            "description": "OpenAI-compatible chat completion endpoint. Use a chat-capable model ID returned by GET /v1/models."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 2xx\", function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});"
                ]
              }
            }
          ]
        },
