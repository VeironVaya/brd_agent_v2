# Database connection (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/brd_db

# RAG & pgvector database connection (psycopg driver)
RAG_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brd_db

# Security & JWT
JWT_SECRET=supersecretjwtkey_change_me_in_production
JWT_EXPIRY_HOURS=168
CORS_ORIGINS=http://localhost:5173

# LLM Providers (Provide at least one key)
GEMINI_API_KEY=
GROQ_API_KEY=

