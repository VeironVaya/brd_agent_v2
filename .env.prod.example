# Production environment file — lives at /opt/brd-agent-v2/.env on the
# EC2 instance (copied there manually once, NOT committed, NOT touched by
# CI/CD deploys). Read by docker-compose.prod.yml.

# Postgres credentials — pick a real password, not the dev default.
POSTGRES_USER=brdagent
POSTGRES_PASSWORD=change_me_to_a_real_random_password
POSTGRES_DB=brdagent

# JWT signing secret — any long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRY_HOURS=168

# Elastic IP of the EC2 instance (from `terraform output public_ip` in
# infra/terraform-ec2) — used to set CORS_ORIGINS correctly.
PUBLIC_IP=203.0.113.10

# LLM providers (at least one required for real AI replies).
GEMINI_API_KEY=
GROQ_API_KEY=

# Which image tag to deploy — the CI/CD workflow overrides this per-deploy
# (usually the short git SHA); "latest" is the local/manual default.
IMAGE_TAG=latest
