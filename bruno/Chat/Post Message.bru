meta {
  name: Post Message
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/conversations/{{conversationId}}/rooms/{{roomId}}/messages
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "text": "Vendor master data lives in SAP Ariba."
  }
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("returns user + agent messages", function () {
    expect(res.body.messages).to.have.lengthOf(2);
    expect(res.body.messages[0].role).to.equal("user");
    expect(res.body.messages[1].role).to.equal("agent");
  });
}
