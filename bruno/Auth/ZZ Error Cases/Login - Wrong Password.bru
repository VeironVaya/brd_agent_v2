meta {
  name: Login - Wrong Password
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{registerEmail}}",
    "password": "definitely-not-the-right-password"
  }
}

tests {
  test("status is 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
  test("error code is invalid_credentials", function () {
    expect(res.body.error).to.equal("invalid_credentials");
  });
}
