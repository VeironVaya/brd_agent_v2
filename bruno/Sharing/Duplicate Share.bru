meta {
  name: Duplicate Share
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/conversations/{{sharingConversationId}}/collaborators
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "email": "{{viewerEmail}}",
    "role": "viewer"
  }
}

tests {
  test("status is 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("error code is already_shared", function () {
    expect(res.body.error).to.equal("already_shared");
  });
}
