meta {
  name: Create Conversation
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/conversations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Vendor Onboarding Platform",
    "context": "A sentence or two on what this BRD is for."
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("conversationId", res.body.id);
  }
}

tests {
  test("status is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("returns an id", function () {
    expect(res.body).to.have.property("id");
  });
}
